[Unit]
Description=LinkDock bookmark synchronization API
After=network.target

[Service]
Type=simple
User=linkdock
Group=linkdock
WorkingDirectory=/opt/linkdock
EnvironmentFile=/etc/linkdock.env
ExecStart=/usr/bin/node /opt/linkdock/server.cjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/linkdock

[Install]
WantedBy=multi-user.target
