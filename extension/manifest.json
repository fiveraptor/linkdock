{
  "manifest_version": 3,
  "name": "LinkDock",
  "description": "Deine Favoriten, gemeinsam gespeichert auf deinem LinkDock-Server.",
  "action": {
    "default_title": "LinkDock öffnen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
